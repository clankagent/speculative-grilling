{
  "name": "speculative-grilling",
  "version": "0.1.0",
  "private": true,
  "description": "A shared speculative clarification engine for Pi and MCP",
  "license": "MIT",
  "bin": {
    "grill": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js",
    "./mcp": "./dist/src/adapters/mcp.js"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vp test run",
    "build": "tsc && node scripts/copy-web.mjs",
    "web": "tsx src/web/main.ts",
    "demo": "tsx examples/session.ts",
    "benchmark": "tsx examples/benchmark.ts",
    "qualify:live": "tsx examples/qualify-live.ts",
    "qualify:jev": "tsx examples/qualify-jev.ts",
    "check:public": "node scripts/check-public.mjs",
    "mcp": "tsx src/adapters/mcp-main.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "typebox": "1.3.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^24.13.5",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite-plus": "0.3.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pi": {
    "extensions": [
      "./dist/src/adapters/pi.js"
    ]
  }
}
