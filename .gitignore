# Initial publication allowlist. Expand deliberately as implementation begins.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/CONTRIBUTING.md
!/docs/
/docs/*
!/docs/product-brief.md
!/docs/architecture.md
!/docs/roadmap.md
!/docs/integration-research.md
!/docs/public-data-policy.md
!/docs/running.md
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/vite.config.ts
!/src/
!/tests/
!/examples/
!/scripts/
!/.github/
!/LICENSE
**/node_modules/
**/dist/
**/.env*
**/*.db*
**/*.sqlite*
**/*.log
**/*.pem
**/*.key
**/auth.json
**/.pi/
**/.codex/
**/.DS_Store
